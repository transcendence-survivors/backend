<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>{{title}}</title>
		<style>
			body,
			table,
			td,
			p,
			a,
			li {
				font-family:
					-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
					Helvetica, Arial, sans-serif;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}
			body {
				margin: 0;
				padding: 0;
				background-color: #1a1a19;
				width: 100% !important;
			}
			table {
				border-collapse: collapse;
				width: 100%;
			}

			.email-wrapper {
				background-color: #1a1a19;
				padding: 40px 20px;
			}
			.email-container {
				max-width: 600px;
				background-color: #212120;
				border-radius: 12px;
				border: 1px solid #333331;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
				overflow: hidden;
				margin: 0 auto;
			}

			.email-header {
				background: linear-gradient(135deg, #2a2a28 0%, #212120 100%);
				border-bottom: 1px solid #333331;
				padding: 40px 40px 30px 40px;
				text-align: center;
			}
			.brand-icon {
				background-color: #e54b4b;
				width: 48px;
				height: 48px;
				border-radius: 10px;
				display: inline-block;
				margin-bottom: 16px;
				line-height: 48px;
				color: #ffffff;
				font-weight: bold;
				font-size: 20px;
			}
			.header-title {
				margin: 0;
				color: #e54b4b;
				font-size: 14px;
				font-weight: 600;
				letter-spacing: 1px;
				text-transform: uppercase;
			}

			.email-body {
				padding: 40px 40px 30px 40px;
				text-align: left;
			}
			.main-heading {
				margin: 0 0 16px 0;
				color: #f0ede6;
				font-size: 26px;
				font-weight: 700;
				line-height: 1.3;
			}
			.text-paragraph {
				margin: 0 0 20px 0;
				color: #9f9e9a;
				font-size: 16px;
				line-height: 1.6;
			}

			.alert-box {
				background-color: rgba(229, 75, 75, 0.12);
				border-left: 4px solid #e54b4b;
				padding: 16px;
				border-radius: 0 8px 8px 0;
				margin-bottom: 32px;
			}
			.alert-text {
				margin: 0;
				color: #f28b8b;
				font-size: 15px;
				font-weight: 500;
				line-height: 1.5;
			}

			.email-footer {
				padding: 0 40px 40px 40px;
				background-color: #212120;
				text-align: center;
			}
			.footer-divider {
				border: 0;
				border-top: 1px solid #333331;
				margin: 0 0 24px 0;
			}
			.footer-text {
				margin: 0 0 8px 0;
				color: #9f9e9a;
				font-size: 13px;
				line-height: 1.5;
			}
			.copyright-text {
				margin: 0;
				color: #9f9e9a;
				font-size: 13px;
				font-weight: 500;
			}
		</style>
	</head>
	<body>

		<table border='0' cellpadding='0' cellspacing='0' class='email-wrapper'>
			<tr>
				<td align='center' valign='top'>

					<table
						border='0'
						cellpadding='0'
						cellspacing='0'
						class='email-container'
					>

						<tr>
							<td class='email-header'>
								<div class='brand-icon'>🗑</div>
								<header>
									<p class='header-title'>{{headerSub}}</p>
								</header>
							</td>
						</tr>

						<tr>
							<td class='email-body'>
								<main>
									<h1 class='main-heading'>{{title}}</h1>
									<p class='text-paragraph'>{{greeting}}</p>
									<p class='text-paragraph'>{{message}}</p>

									<div class='alert-box'>
										<p class='alert-text'>
											{{deletionConfirmed}}
										</p>
									</div>
								</main>
							</td>
						</tr>

						<tr>
							<td class='email-footer'>
								<hr class='footer-divider' />
								<footer>
									<p class='footer-text'>
										{{automatedEmailText}}
									</p>
									<p class='copyright-text'>
										&copy;
										{{year}}
										{{APP_NAME}}.
										{{rights_reserved}}
									</p>
								</footer>
							</td>
						</tr>

					</table>
				</td>
			</tr>
		</table>
	</body>
</html>