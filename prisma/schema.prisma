generator client {
    provider     = "prisma-client"
    output       = "./generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    USER
    ADMIN
    SUPER_ADMIN
}

enum PresencePreferedStatus {
    ONLINE
    INVISIBLE
    DO_NOT_DISTURB
}

enum FriendshipState {
    PENDING
    ACCEPTED
}

enum LocalePreference {
    EN
    FR
    DE
    ES
    IT
}

enum UserGender {
    MALE
    FEMALE
    OTHER
    PREFER_NOT_TO_SAY
}

enum AuthProviderType {
    LOCAL
    GOOGLE
    GITHUB
    SCHOOL
}

model User {
    id       String @id @default(uuid())
    username String @unique
    email    String @unique

    gender    UserGender
    firstName String
    lastName  String
    birthDate DateTime

    displayName String
    bio         String?

    avatarUrl     String?
    coverImageUrl String?
    location      String?
    website       String?

    localePreference       LocalePreference       @default(EN)
    role                   UserRole               @default(USER)
    preferedPresenceStatus PresencePreferedStatus @default(ONLINE)
    lastActiveAt           DateTime               @default(now())

    stats UserStats? @relation

    posts Post[]
    likes Like[]

    providers     AuthProvider[]
    refreshTokens RefreshToken[]
    resetTokens   ResetPasswordToken[]

    friendshipsA   Friendship[] @relation("friendA")
    friendshipsB   Friendship[] @relation("friendB")
    blocksGiven    Block[]      @relation("blocker")
    blocksReceived Block[]      @relation("blocked")

    createdChatRooms ChatRoom[]    @relation("RoomCreator")
    chatMemberships  ChatMember[]
    chatMessages     ChatMessage[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Friendship {
    id String @id @default(uuid())

    userAId  String
    userBId  String
    senderId String

    state FriendshipState

    userA User @relation("friendA", fields: [userAId], references: [id], onDelete: Cascade)
    userB User @relation("friendB", fields: [userBId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userAId, userBId])
    @@index([userAId])
    @@index([userBId])
    @@index([senderId])
}

model Block {
    id String @id @default(uuid())

    blockerId String
    blockedId String

    blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
    blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([blockerId, blockedId])
    @@index([blockerId])
    @@index([blockedId])
}

model AuthProvider {
    id       String           @id @default(uuid())
    provider AuthProviderType

    providerId String?
    password   String?

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([userId, provider])
    @@index([provider, providerId])
}

model RefreshToken {
    id        Int     @id @default(autoincrement())
    hashToken String  @unique
    userAgent String?
    ip        String?
    deviceId  String?
    familyId  String  @default(uuid())
    isRevoked Boolean @default(false)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    expiredAt DateTime

    @@index([expiredAt])
    @@index([userId])
    @@index([familyId])
}

model ResetPasswordToken {
    id String @id @default(uuid())

    tokenHash String @unique

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    used Boolean @default(false)

    createdAt DateTime @default(now())
    expiresAt DateTime

    @@index([userId])
    @@index([expiresAt])
}

model UserStats {
    userId String @id

    postCount      Int @default(0)
    followerCount  Int @default(0)
    followingCount Int @default(0)

    likesGiven    Int @default(0)
    likesReceived Int @default(0)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
    id String @id @default(uuid())

    content  String?
    imageUrl String?
    authorId String
    author   User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

    likes Like[]

    createdAt DateTime @default(now())

    parentPostId String?
    parent       Post?   @relation("PostReplies", fields: [parentPostId], references: [id], onDelete: Cascade)
    replies      Post[]  @relation("PostReplies")

    quotedPostId String?
    quotedPost   Post?   @relation("PostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull)
    quotes       Post[]  @relation("PostQuotes")
}

model Like {
    id String @id @default(uuid())

    userId String
    postId String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([userId, postId])
}

enum ChatMemberRole {
    OWNER
    ADMIN
    MEMBER
}

enum ChatRoomType {
    DIRECT
    GROUP
}

model ChatRoom {
    id        String       @id @default(uuid())
    type      ChatRoomType @default(GROUP)
    name      String?
    avatarUrl String?

    createdBy String
    creator   User   @relation("RoomCreator", fields: [createdBy], references: [id])

    members  ChatMember[]
    messages ChatMessage[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ChatMember {
    id     String         @id @default(uuid())
    roomId String
    userId String
    role   ChatMemberRole @default(MEMBER)

    joinedAt   DateTime  @default(now())
    lastReadAt DateTime?
    isMuted    Boolean   @default(false)

    room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
    user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([roomId, userId])
    @@index([userId])
}

model ChatMessage {
    id       String @id @default(uuid())
    roomId   String
    senderId String

    content String?

    replyToId String?
    replyTo   ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id])
    replies   ChatMessage[] @relation("MessageReplies")

    isEdited  Boolean @default(false)
    isDeleted Boolean @default(false)

    room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
    sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

    attachmentUrls String[] @default([])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([roomId, createdAt])
    @@index([senderId])
}
